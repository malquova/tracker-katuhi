{
  "name": "time-tracker",
  "version": "1.0.0",
  "description": "Трекер времени",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.timetracker.app",
    "productName": "Трекер Катюхи",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "icon": "icon.icns"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.1"
  }
}
